# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# RESEND_API_KEY: Secret API key for Resend email service
RESEND_API_KEY=""

# RECIPIENT_EMAIL: The email address where form registrations should be delivered (default: Genadehomes@gmail.com)
RECIPIENT_EMAIL="Genadehomes@gmail.com"

# SENDER_EMAIL: The verified sender address in Resend (default for testing: Abuja Realtors Summit <onboarding@resend.dev>)
SENDER_EMAIL="Abuja Realtors Summit <onboarding@resend.dev>"
